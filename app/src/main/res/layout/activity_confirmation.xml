<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:text="Halo ,Amry Musyaffa"
        android:textColor="#000000"
        android:textSize="22sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginBottom="60dp"

        android:clipToOutline="true">


        <!-- Gambar Logo -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/kopikuy"
            android:contentDescription="Logo Kopi" />
    </FrameLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="Terima kasih sudah memesan tunggu aja sebentar kurir kami segera mengantarkan pesananmu!"
        android:textColor="#888888"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnOke"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="48dp"
        android:backgroundTint="#000000"
        android:text="Oke"
        android:textColor="#FFFFFF" />
</LinearLayout>